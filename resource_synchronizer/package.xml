<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>resource_synchronizer</name>
  <version>0.2.0</version>
  <description>resource_synchronizer package.</description>

  <maintainer email="gsarthou@laas.fr">Guillaume Sarthou</maintainer>
  <license>TBD</license>

  <depend>resource_management_msgs</depend>
  <depend>resource_synchronizer_msgs</depend>
  <depend>resource_management</depend>
  <depend>std_msgs</depend>

  <!--ros1-->

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>

  <depend condition="$ROS_VERSION == 1">message_generation</depend>
  <depend condition="$ROS_VERSION == 1">roscpp</depend>

  <exec_depend condition="$ROS_VERSION == 1">message_runtime</exec_depend>

  <!--ros2-->

  <depend condition="$ROS_VERSION == 2">rclcpp</depend>
  <depend condition="$ROS_VERSION == 2">builtin_interfaces</depend>

  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">rosidl_default_generators</buildtool_depend>

  <test_depend condition="$ROS_VERSION == 2">ament_lint_auto</test_depend>
  <test_depend condition="$ROS_VERSION == 2">ament_lint_common</test_depend>
  <test_depend condition="$ROS_VERSION == 2">ament_cmake_gtest</test_depend>

  <exec_depend condition="$ROS_VERSION == 2">rosidl_default_runtime</exec_depend>

  <member_of_group condition="$ROS_VERSION == 2">rosidl_interface_packages</member_of_group>

</package>
